{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Integra",
  "version": "1.0.3",
  "identifier": "br.com.integra.producaoisolada",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Integra - Sistema de produção isolada",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDNjBGNDZBOTRFRUZCRUEKUldUcSsrNlVhdlJnVExtSVBLaW5IclQwQ1hYd2JITGxtNVVvRzVKYWl3QjlGaFMxNnRuRUdrVFcK",
      "endpoints": [
        "https://github.com/DaviLadwig/integra_desktop/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Integra - Sistema de produção isolada",
    "longDescription": "Aplicativo desktop offline para importação, acompanhamento e análise das produções SIAPS.",
    "copyright": "Integra",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Integra"
      }
    }
  }
}
